# Supabase project (Auth + Postgres). The Postgres connection strings are
# derived from these — see server/utils/supabase-db.ts. Runtime uses the
# transaction pooler (6543); Prisma Migrate and the seeder use session mode (5432).
NUXT_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_SUPABASE_KEY=<publishable-key>
NUXT_SUPABASE_PASSWORD=<database-password>
# Pooler host from the dashboard's "Connect" dialog; region and the aws-N
# prefix vary per project, so it cannot be derived from the URL.
NUXT_SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com

# RajaOngkir API V2 (Komerce) — destination search, cost, waybill tracking
NUXT_RAJAONGKIR_SHIPPING_COST_API_KEY=<shipping-cost-key>

# Komship Delivery API — order handoff, pickup, AWB
NUXT_RAJAONGKIR_GENERAL_API_KEY=<delivery-key>
NUXT_KOMSHIP_BASE_URL=https://api-sandbox.collaborator.komerce.id

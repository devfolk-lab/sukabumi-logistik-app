# Supabase project (Auth + Postgres)
NUXT_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_SUPABASE_KEY=<publishable-key>

# Postgres via the Supavisor pooler. Runtime uses transaction mode (6543);
# Prisma Migrate uses session mode (5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# RajaOngkir API V2 (Komerce) — destination search, cost, waybill tracking
NUXT_RAJAONGKIR_SHIPPING_COST_API_KEY=<shipping-cost-key>

# Komship Delivery API — order handoff, pickup, AWB
NUXT_RAJAONGKIR_GENERAL_API_KEY=<delivery-key>
NUXT_KOMSHIP_BASE_URL=https://api-sandbox.collaborator.komerce.id

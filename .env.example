# Origin used in the links inside account emails (confirm email, reset
# password). Set it to the deployed URL in production.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number the "Pusat Bantuan" button opens a chat with, in
# international form without "+" or spaces.
NUXT_PUBLIC_HELP_WHATSAPP=628111112123

# Supabase Postgres, both copied as-is from the dashboard's "Connect" dialog.
# Only the database is used from Supabase; accounts and sessions are our own
# tables.
# Runtime uses the transaction pooler (6543); Prisma Migrate and the seeder use
# the session pooler (5432), which can hold Migrate's advisory locks.
NUXT_SUPABASE_DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
NUXT_SUPABASE_DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Biteship — area search, rates, order handoff, tracking. A `biteship_test.`
# key simulates every order; rates and waybill tracking still need account
# balance, even in test mode.
NUXT_BITESHIP_API_KEY=biteship_test.<key>
NUXT_BITESHIP_BASE_URL=https://api.biteship.com

# Outgoing email through Gmail SMTP (nuxt-nodemailer). The password is a Google
# app password (Google Account → Security → App passwords), which needs 2-Step
# Verification; the account password itself is refused. Gmail only sends as the
# signed-in address, so FROM must use the same email.
NUXT_NODEMAILER_AUTH_USER=<gmail-address>
NUXT_NODEMAILER_AUTH_PASS=<gmail-app-password>
NUXT_NODEMAILER_FROM="Sukabumi Logistik <gmail-address>"

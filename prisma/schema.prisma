// Prisma schema for Sukabumi Logistik.
//
// Identity is ours: `User` holds the credentials, `Session` the signed-in
// devices, `AuthToken` the emailed one-time links. `Profile` shares the user's
// id and holds everything else about the account.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  DIPROSES
  DIJEMPUT
  DALAM_PERJALANAN
  SELESAI
  BATAL
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Login credentials. Accounts created under Supabase Auth were imported with
// their ids and hashes intact (migration 20261001090000_own_auth).
model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Always stored lowercase.
  email           String    @unique
  // bcrypt, the scheme Supabase Auth used, so imported hashes still verify.
  passwordHash    String
  // Null until the confirmation link is opened; login is refused until then.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile    Profile?
  sessions   Session[]
  authTokens AuthToken[]

  @@map("users")
}

// One signed-in device. The cookie carries a random token; only its SHA-256
// is stored, so a leaked table cannot be replayed as cookies.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// A single-use emailed link (confirm email, reset password). Stored as the
// SHA-256 of the token, like sessions, and deleted once used.
model AuthToken {
  id        String        @id
  userId    String        @db.Uuid
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  // Same value as `User.id`.
  id        String   @id @db.Uuid
  nama      String
  email     String
  telp      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  @@map("profiles")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @db.Uuid
  label     String
  nama      String
  telp      String
  alamat    String

  // The Biteship area (kecamatan + postal code) exactly as `/v1/maps/areas`
  // returned it, so orders placed from this address need no second lookup.
  // Null for an address that has no kecamatan yet.
  area Json?

  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("addresses")
}

model Order {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid

  // Human-facing reference, e.g. SL-2026-8843.
  orderNo String      @unique
  status  OrderStatus @default(MENUNGGU_PEMBAYARAN)

  // Party snapshots — orders must stay readable after an address is edited.
  senderNama     String
  senderTelp     String
  senderAlamat   String
  receiverNama   String
  receiverTelp   String
  receiverAlamat String

  // Biteship areas, verbatim as `/v1/maps/areas` returned them. Orders placed
  // before the Biteship switch carry their old RajaOngkir id as `id`.
  originArea      Json
  destinationArea Json

  courierCode String
  courierName String
  serviceCode String
  serviceName String
  etd         String?

  // Sum of every item's weight × quantity, as quoted.
  weightGram Int

  // `total` equals `shippingCost` today; kept separate so surcharges can be
  // added later without rewriting history.
  shippingCost Int
  total        Int

  // Paid by manual bank transfer: an admin checks the transfer and confirms
  // the Biteship draft order, and the app records that as "TRANSFER". Orders
  // from the earlier demo checkout carry "DEMO".
  paymentMethod String?
  paidAt        DateTime?

  // Biteship draft order created with the order. It holds the booking without
  // a courier or waybill until an admin confirms it in the Biteship dashboard.
  biteshipDraftId String? @unique

  // Set once the draft is confirmed and Biteship has booked the courier.
  awb                String?
  biteshipOrderId    String?
  biteshipTrackingId String?
  trackingUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  trackingEvents TrackingEvent[]

  @@index([profileId, createdAt])
  @@index([awb])
  @@map("orders")
}

// One package line, with the fields Biteship takes in `items` on rates and
// orders. Weight in grams, dimensions in centimetres, value in rupiah.
model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  // Order the lines were entered in.
  position Int

  name        String
  description String?
  category    String?
  sku         String?
  value       Int
  quantity    Int
  weight      Int
  length      Int?
  width       Int?
  height      Int?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model TrackingEvent {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  title      String
  /// Biteship's status code (`picked`, `in_transit`…), lowercase; picks the icon.
  status     String?
  /// Biteship's own note for the event, as the carrier wrote it.
  note       String?
  location   String?
  occurredAt DateTime

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, title, occurredAt])
  @@index([orderId, occurredAt])
  @@map("tracking_events")
}
